{
  "manifest_version": 3,
  "name": "BaaDash 下载助手",
  "version": "0.6.1",
  "description": "多连接下载与断点续传，支持图片和 Pixiv 当前作品一键下载、视频下载及本地另存 GIF。",
  "key": "",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "cookies",
    "contextMenus",
    "storage",
    "webRequest"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["preferences.js", "content.js", "image-button.js", "image.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://www.pixiv.net/*", "https://pixiv.net/*"],
      "js": ["preferences.js", "image-button.js", "pixiv.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["yt.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/NotoSansSC-Variable.woff2"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "action": {
    "default_title": "BaaDash 下载助手",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "64": "icons/64.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "64": "icons/64.png",
    "128": "icons/128.png"
  },
  "short_name": "BaaDash"
}
